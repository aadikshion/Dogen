# Copy this file to .env.local and fill in real values.
# Never commit .env.local. It is already in .gitignore.

# Google AI (used to read the dog photo and write the profile)
GOOGLE_AI_API_KEY=

# ElevenLabs (used to give the dog a voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Brickken sandbox
BRICKKEN_API_KEY=
BRICKKEN_BASE_URL=https://api.sandbox.brickken.com
BRICKKEN_CHAIN_ID=aa36a7

# Signer wallet. This wallet must be whitelisted by Brickken before use.
# Never commit this. Ask for a fresh key request from tech@brickken.com if it leaks.
BRICKKEN_SIGNER_PRIVATE_KEY=
BRICKKEN_SIGNER_ADDRESS=
